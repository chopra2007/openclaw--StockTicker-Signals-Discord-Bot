#!/usr/bin/env bash
#
# pre-push hook — regression gate. Restored 2026-05-26 (Pass 5, Section 2N).
# Codex review flagged that the previous `exit 0` short-circuit eliminated
# the local safety net. CI also runs the suite, but the local hook catches
# regressions before they hit origin.
#
# Bypass for a genuine exception: `git push --no-verify`.
#
set -e

LOG="/tmp/pytest-prepush-$(id -u).log"   # per-user path: a fixed /tmp path root-owned by a
                                         # prior run made `tee` permission-denied → set -e aborted
                                         # the hook → push rejected silently (2026-07-02, #59).
REPO_ROOT="$(git rev-parse --show-toplevel)"
BASELINE="$REPO_ROOT/.test-baseline"

# --- Clean-install resolution gate ---------------------------------------
# The test suite below runs in an ALREADY-satisfied venv, so an unsatisfiable
# pin (e.g. a version string that no published release matches) passes here but
# turns CI red — CI does a fresh `pip install` from a clean index. This catches
# that class before the push, but ONLY when a requirements file actually
# changed, so ordinary code pushes stay fast.
#   Real case it would have caught: `mplfinance>=0.12.10` when only pre-release
#   builds (…b0) exist — `0.12.10b0 < 0.12.10`, so the pin matched nothing and
#   reddened CI for two days while every local push stayed green.
REQ_FILES="requirements.txt requirements-dev.txt"
if git rev-parse --verify -q origin/master >/dev/null \
   && ! git diff --quiet origin/master -- $REQ_FILES 2>/dev/null; then
    echo "[pre-push] requirements changed — checking they resolve from a clean index..."
    RESOLVE_LOG="/tmp/pip-resolve-prepush-$(id -u).log"  # per-user (same cross-user /tmp trap as LOG above)
    RESOLVE_TMP="$(mktemp -d)"
    # pip 22.0.2 has no --dry-run; `download --no-deps` resolves the DIRECT pins
    # (no transitive download) and is the lightest clean-resolution probe here.
    # `|| true` keeps pip's exit code from tripping `set -e`; we classify below.
    python3 -m pip download --no-deps -r "$REPO_ROOT/requirements-dev.txt" \
        -d "$RESOLVE_TMP" > "$RESOLVE_LOG" 2>&1 || true
    rm -rf "$RESOLVE_TMP"
    if grep -qiE 'No matching distribution|Could not find a version|ResolutionImpossible' "$RESOLVE_LOG"; then
        echo ""
        echo "[pre-push] BLOCKED — a requirement can't be installed from a clean index:"
        grep -iE 'No matching distribution|Could not find a version|ResolutionImpossible' "$RESOLVE_LOG" | sed 's/^/  /'
        echo ""
        echo "Passes locally (your venv already has it) but reddens CI on a fresh install."
        echo "Fix the pin in requirements*.txt — e.g. a pre-release needs an explicit b0/a0/rc1 suffix."
        echo "Full log: $RESOLVE_LOG"
        exit 1
    fi
    # Any other pip failure (network, index down) is NOT a reason to block a push.
    if [ -s "$RESOLVE_LOG" ] && grep -qiE '^ERROR|^WARNING: Retrying' "$RESOLVE_LOG"; then
        echo "[pre-push] WARN — couldn't fully verify resolution (network/index?); continuing. Log: $RESOLVE_LOG"
    else
        echo "[pre-push] OK — requirements resolve from a clean index."
    fi
fi
# -------------------------------------------------------------------------

echo "[pre-push] running regression suite (parallel: 2 workers)..."
# -n 2 (pytest-xdist): ~1.75x faster (~3:33 -> ~2:00) and verified to leave the
#   suite all-green (no worker collisions). Capped at 2 of 4 cores so the live
#   consensus-engine/gateway keep headroom during a push.
# -rf: guarantee the "FAILED <id>" summary lines the regression parser below
#   relies on, regardless of xdist output ordering.
# --color=no is LOAD-BEARING: Claude Code sets FORCE_COLOR=3, which makes pytest
#   colourize even into a file, so the summary line becomes
#   "\x1b[31mFAILED\x1b[0m tests/..." and the `^FAILED ` parser below matches
#   NOTHING. Every push from a Claude session then passed a gate that could not
#   see red tests. Verified 2026-07-13 with a deliberately failing test.
python3 -m pytest tests/ -n 2 --tb=line -q -rf --color=no 2>&1 | tee "$LOG"

# Extract current failures (sorted, unique)
CURRENT_FAILS=$(grep -E '^FAILED ' "$LOG" | awk '{print $2}' | sort -u)

# Baseline failures — known-bug class, empty file means "must be all green"
BASELINE_FAILS=""
[ -s "$BASELINE" ] && BASELINE_FAILS=$(sort -u "$BASELINE")

# Regressions = current failures NOT in baseline
REGRESSIONS=$(comm -23 <(printf '%s\n' "$CURRENT_FAILS") <(printf '%s\n' "$BASELINE_FAILS"))

if [ -n "$REGRESSIONS" ]; then
    echo ""
    echo "[pre-push] BLOCKED — new test failures not in .test-baseline:"
    printf '  - %s\n' $REGRESSIONS
    echo ""
    echo "Either fix the test or, if intentionally accepted as known-bug,"
    echo "add the ID to .test-baseline and commit that change first."
    exit 1
fi

echo "[pre-push] OK — no regression vs baseline."
exit 0
