#!/usr/bin/env bash
#
# pre-push hook — regression gate runs in GitHub Actions CI, not locally.
# Push goes through immediately; Discord gets a pass/fail notification from CI.
#
# To bypass CI gate for a genuine exception: push with a commit message
# containing "[skip ci]".
#
echo "[pre-push] push allowed — regression gate runs in CI (watch Discord for results)."
exit 0
