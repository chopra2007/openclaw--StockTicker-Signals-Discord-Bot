[Unit]
Description=Collect TODO 109 stock quotes every minute in the Pacific collection window

[Timer]
OnCalendar=Mon..Fri *-*-* 04..16:*:00 America/Los_Angeles
OnCalendar=Mon..Fri *-*-* 17:00:00 America/Los_Angeles
Persistent=true
AccuracySec=1s
Unit=full-chain-stock-poll.service

[Install]
WantedBy=timers.target
