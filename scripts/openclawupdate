#!/usr/bin/env bash
# openclawupdate — update OpenClaw on this host.
#
# The gateway runs as a system-wide systemd unit
# (/etc/systemd/system/openclaw-gateway.service). OpenClaw only manages *user*
# systemd units: it reads a unit's command over the user D-Bus, finds nothing
# for a system unit, and since 2026.9.3 refuses to touch program files at all
# ("managed-service-preflight: Gateway service inspection is unavailable").
#
# So this script does the two halves itself, in the order OpenClaw needs:
#
#   1. program files — npm, as root, because /usr/lib/node_modules is root-owned.
#      Skipped entirely when the installed version already matches the registry.
#   2. finalize — `openclaw update repair` as the openclaw account, with the
#      gateway STOPPED. Its doctor step takes an exclusive lease on the agent
#      database and fails with OpenClawAgentDatabaseLeaseActiveError if the
#      gateway is still holding it.
#
# The unit is stopped for both halves and started once at the end, so the
# gateway restarts exactly once per update.
set -uo pipefail

UNIT=openclaw-gateway.service
WATCHDOG_TIMER=gateway-watchdog.timer
WATCHDOG_SERVICE=gateway-watchdog.service
ACCOUNT=openclaw
STATE=/home/openclaw/.openclaw
CONFIG="$STATE/openclaw.json"
OWNERSHIP="$STATE/workspace/scripts/check_ownership.py"
PKG_ROOT=/usr/lib/node_modules/openclaw
PORT=18789
SUCCESS="$STATE/openclawupdate-success"
force_repair=0
case "${1:-}" in
  "") ;;
  --repair) force_repair=1 ;;
  *) echo "Usage: openclawupdate [--repair]" >&2; exit 2 ;;
esac
SECONDS=0

# Behave the same whether or not the caller's shell exports these.
unset OPENCLAW_STATE_DIR OPENCLAW_CONFIG_PATH OPENCLAW_WORKSPACE_DIR

if [ "$(id -u)" -ne 0 ]; then
  echo "openclawupdate: run this as root — it needs systemctl and writes /usr/lib/node_modules." >&2
  exit 1
fi

installed_version() {
  node -p "require('$PKG_ROOT/package.json').version" 2>/dev/null
}

installation_fingerprint() {
  # A later update/repair attempt invalidates the receipt even if it left the
  # version and config unchanged. Unknown ledger schemas fail closed.
  python3 - "$CONFIG" "$STATE/state/openclaw.sqlite" <<'PY'
import hashlib, json, pathlib, sqlite3, sys
try:
    with sqlite3.connect(pathlib.Path(sys.argv[2]).as_uri() + '?mode=ro', uri=True) as db:
        rows = db.execute('SELECT run_id, updated_at_ms, phase, status FROM update_runs ORDER BY run_id').fetchall()
    print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes() + json.dumps(rows).encode()).hexdigest())
except (OSError, sqlite3.Error):
    sys.exit(1)
PY
}

# Do network work before taking the bot offline. A successful previous repair
# permits a healthy, unchanged installation to return without repeating Doctor.
from=$(installed_version)
if ! latest=$(timeout --kill-after=5 30 npm view openclaw version 2>/dev/null) || [ -z "$latest" ]; then
  echo "openclawupdate: could not reach the npm registry; gateway left running." >&2
  exit 1
fi
fingerprint=$(installation_fingerprint) || fingerprint=""
if [ "$force_repair" -eq 0 ] && [ "$latest" = "$from" ] \
   && [ -n "$fingerprint" ] && [ -f "$SUCCESS" ] && [ "$(cat "$SUCCESS")" = "$from $fingerprint" ] \
   && systemctl is-active --quiet "$UNIT" \
   && timeout --kill-after=5 15 sudo -u "$ACCOUNT" -H openclaw gateway health >/dev/null 2>&1; then
  echo "OK — already on $from; the gateway is healthy (${SECONDS}s, no restart)."
  exit 0
fi
# Never let an interrupted or failed repair reuse an earlier success receipt.
rm -f "$SUCCESS"
backup="$CONFIG.bak-$(date +%Y%m%d-%H%M%S)"
cp -p "$CONFIG" "$backup" || exit 1
before=$(md5sum < "$CONFIG")

started=0
watchdog_was_active=0
start_gateway() {
  [ "$started" -eq 1 ] && return
  started=1
  # npm ran as root, so anything it left behind under the state dir goes back
  # to the bot before the gateway tries to write it.
  [ -f "$OWNERSHIP" ] && python3 "$OWNERSHIP" --fix --quiet
  systemctl start "$UNIT" || echo "openclawupdate: systemctl start failed." >&2
}
restore_watchdog() {
  if [ "$watchdog_was_active" -eq 1 ]; then
    if ! systemctl start "$WATCHDOG_TIMER"; then
      echo "openclawupdate: could not restore gateway watchdog." >&2
      return 1
    fi
    watchdog_was_active=0
  fi
}
cleanup() {
  local status=$?
  start_gateway
  # Resume monitoring only after the health check (or on an early failure).
  restore_watchdog || { [ "$status" -ne 0 ] || status=1; }
  exit "$status"
}
# Bring the gateway back even if the update dies or you press Ctrl-C.
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# The watchdog otherwise interprets intentional update downtime as an outage
# and restarts the gateway while Doctor owns its database maintenance lease.
if systemctl is-active --quiet "$WATCHDOG_TIMER"; then
  watchdog_was_active=1
fi
systemctl stop "$WATCHDOG_TIMER" "$WATCHDOG_SERVICE" || exit 1

systemctl stop "$UNIT" || exit 1

# `systemctl stop` returns as soon as the unit is inactive, but doctor's
# session-store maintenance refuses to run while anything still holds the state
# directory ("a maintenance command owns the state directory"). Wait for the
# gateway process to be gone and the port to be free before phase 2.
for _ in $(seq 1 30); do
  if ! pgrep -u "$ACCOUNT" -f "openclaw gateway" >/dev/null 2>&1 \
     && ! ss -ltn "sport = :$PORT" 2>/dev/null | grep -q ":$PORT"; then
    break
  fi
  sleep 1
done

rc=0
if [ "$latest" != "$from" ]; then
  echo "==> updating program files: $from -> $latest (${SECONDS}s elapsed)"
  timeout --kill-after=15 300 npm i -g "openclaw@$latest" --loglevel=error --no-fund --no-audit || rc=$?
fi

if [ "$rc" -eq 0 ]; then
  echo "==> finalizing plugins and state (${SECONDS}s elapsed)"
  # The system unit is restored below. Bound the whole subprocess, including
  # upstream plugin scans, instead of multiplying per-phase timeout budgets.
  timeout --kill-after=15 600 sudo -u "$ACCOUNT" -H openclaw update repair --yes --no-restart || rc=$?
fi

echo "==> starting gateway (${SECONDS}s elapsed)"
start_gateway

healthy=0
deadline=$((SECONDS + 90))
while [ "$SECONDS" -lt "$deadline" ]; do
  if timeout --kill-after=5 10 sudo -u "$ACCOUNT" -H openclaw gateway health >/dev/null 2>&1; then healthy=1; break; fi
  sleep 2
done

if [ "$(md5sum < "$CONFIG")" != "$before" ]; then
  echo "NOTE: openclaw.json changed during the update. Previous copy kept at:"
  echo "      $backup"
else
  rm -f "$backup"
fi

if ! systemctl is-active --quiet "$UNIT"; then
  echo "FAILED: $UNIT is not running. Check: systemctl status $UNIT" >&2
  exit 1
fi
if [ "$healthy" -ne 1 ]; then
  echo "FAILED: $UNIT is running but the gateway never answered." >&2
  echo "Check: sudo -u $ACCOUNT -H openclaw gateway status --deep" >&2
  exit 1
fi
if [ "$rc" -ne 0 ]; then
  echo "The update reported errors (exit $rc), but the gateway is back up and healthy." >&2
  exit "$rc"
fi

restore_watchdog || exit 1
to=$(installed_version)
if fingerprint=$(installation_fingerprint); then
  printf '%s %s\n' "$to" "$fingerprint" > "$SUCCESS"
  chown "$ACCOUNT:$ACCOUNT" "$SUCCESS"
fi
if [ "$to" = "$from" ]; then
  echo "OK — already on $to; the gateway is healthy (${SECONDS}s)."
else
  echo "OK — updated $from -> $to; the gateway is healthy (${SECONDS}s)."
fi
