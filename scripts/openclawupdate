#!/usr/bin/env bash
# openclawupdate — update OpenClaw on this host.
#
# The gateway runs as a system-wide systemd unit
# (/etc/systemd/system/openclaw-gateway.service). OpenClaw only manages *user*
# systemd units: it reads a unit's command over the user D-Bus, finds nothing
# for a system unit, and since 2026.9.3 refuses to touch program files at all
# ("managed-service-preflight: Gateway service inspection is unavailable").
#
# So this script does the two halves itself, in the order OpenClaw needs:
#
#   1. program files — npm, as root, because /usr/lib/node_modules is root-owned.
#      Skipped entirely when the installed version already matches the registry.
#   2. finalize — `openclaw update repair` as the openclaw account, with the
#      gateway STOPPED. Its doctor step takes an exclusive lease on the agent
#      database and fails with OpenClawAgentDatabaseLeaseActiveError if the
#      gateway is still holding it.
#
# The unit is stopped for both halves and started once at the end, so the
# gateway restarts exactly once per update.
set -uo pipefail

UNIT=openclaw-gateway.service
ACCOUNT=openclaw
STATE=/home/openclaw/.openclaw
CONFIG="$STATE/openclaw.json"
OWNERSHIP="$STATE/workspace/scripts/check_ownership.py"
PKG_ROOT=/usr/lib/node_modules/openclaw
PORT=18789

# Behave the same whether or not the caller's shell exports these.
unset OPENCLAW_STATE_DIR OPENCLAW_CONFIG_PATH OPENCLAW_WORKSPACE_DIR

if [ "$(id -u)" -ne 0 ]; then
  echo "openclawupdate: run this as root — it needs systemctl and writes /usr/lib/node_modules." >&2
  exit 1
fi

installed_version() {
  node -p "require('$PKG_ROOT/package.json').version" 2>/dev/null
}

backup="$CONFIG.bak-$(date +%Y%m%d-%H%M%S)"
cp -p "$CONFIG" "$backup"
before=$(md5sum < "$CONFIG")
from=$(installed_version)

started=0
start_gateway() {
  [ "$started" -eq 1 ] && return
  started=1
  # npm ran as root, so anything it left behind under the state dir goes back
  # to the bot before the gateway tries to write it.
  [ -f "$OWNERSHIP" ] && python3 "$OWNERSHIP" --fix --quiet
  systemctl start "$UNIT" || echo "openclawupdate: systemctl start failed." >&2
}
# Bring the gateway back even if the update dies or you press Ctrl-C.
trap start_gateway EXIT INT TERM

systemctl stop "$UNIT"

# `systemctl stop` returns as soon as the unit is inactive, but doctor's
# session-store maintenance refuses to run while anything still holds the state
# directory ("a maintenance command owns the state directory"). Wait for the
# gateway process to be gone and the port to be free before phase 2.
for _ in $(seq 1 30); do
  if ! pgrep -u "$ACCOUNT" -f "openclaw gateway" >/dev/null 2>&1 \
     && ! ss -ltn "sport = :$PORT" 2>/dev/null | grep -q ":$PORT"; then
    break
  fi
  sleep 1
done

rc=0
latest=$(npm view openclaw version 2>/dev/null)
if [ -z "$latest" ]; then
  echo "openclawupdate: could not reach the npm registry; leaving program files alone." >&2
  rc=1
elif [ "$latest" != "$from" ]; then
  echo "==> updating program files: $from -> $latest"
  npm i -g "openclaw@$latest" --loglevel=error --no-fund --no-audit || rc=$?
fi

if [ "$rc" -eq 0 ]; then
  # Runs while the gateway is stopped: doctor needs the agent database free.
  sudo -u "$ACCOUNT" -H openclaw update repair --yes || rc=$?
fi

start_gateway
trap - EXIT INT TERM

healthy=0
for _ in $(seq 1 30); do
  if sudo -u "$ACCOUNT" -H openclaw gateway health >/dev/null 2>&1; then healthy=1; break; fi
  sleep 2
done

if [ "$(md5sum < "$CONFIG")" != "$before" ]; then
  echo "NOTE: openclaw.json changed during the update. Previous copy kept at:"
  echo "      $backup"
else
  rm -f "$backup"
fi

if ! systemctl is-active --quiet "$UNIT"; then
  echo "FAILED: $UNIT is not running. Check: systemctl status $UNIT" >&2
  exit 1
fi
if [ "$healthy" -ne 1 ]; then
  echo "FAILED: $UNIT is running but the gateway never answered." >&2
  echo "Check: sudo -u $ACCOUNT -H openclaw gateway status --deep" >&2
  exit 1
fi
if [ "$rc" -ne 0 ]; then
  echo "The update reported errors (exit $rc), but the gateway is back up and healthy." >&2
  exit "$rc"
fi

to=$(installed_version)
if [ "$to" = "$from" ]; then
  echo "OK — already on $to; the gateway is healthy."
else
  echo "OK — updated $from -> $to; the gateway is healthy."
fi
