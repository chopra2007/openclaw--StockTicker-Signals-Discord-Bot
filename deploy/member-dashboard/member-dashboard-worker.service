# Installed by provision.sh. Supervisor + gated compute child (own UID, PID namespace, cgroup).
[Unit]
Description=Member dashboard supervisor
After=member-dashboard-authority.service member-dashboard-quota.service
[Service]
Type=simple
User=md-supervisor
Group=md-supervisor
WorkingDirectory=/opt/member-dashboard/current
ExecStart=/opt/member-dashboard/venv/bin/python -m member_dashboard.operations supervisor --config /etc/member-dashboard/worker.json
Slice=member-dashboard.slice
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID
Delegate=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Outbound internet stays open: the compute child calls OpenRouter/SEC/Schwab (no egress proxy yet).
ReadWritePaths=/var/lib/member-dashboard/web /var/lib/member-dashboard/schwab -/run/member-dashboard-worker
ReadOnlyPaths=/etc/member-dashboard/worker.json /etc/member-dashboard/compute.json /etc/member-dashboard/providers/openrouter.key -/etc/member-dashboard/providers/schwab.json
# Reviewed delegated subtree only; parent/other cgroups remain read-only.
# Delegate=yes hands this service's own cgroup to md-supervisor; compute groups live under compute/.
ReadWritePaths=/sys/fs/cgroup/member.slice/member-dashboard.slice/member-dashboard-worker.service
ExecStartPre=/bin/mkdir -m 0755 -p /sys/fs/cgroup/member.slice/member-dashboard.slice/member-dashboard-worker.service/compute
InaccessiblePaths=-/root -/home/openclaw -/var/lib/member-dashboard/quota
# The bot directory is bound read-only because SQLite recreates its -wal/-shm files (a
# file bind would go stale). File ACLs let md-supervisor read only consensus.db* in it.
BindReadOnlyPaths=/home/openclaw/.openclaw/workspace:/run/member-dashboard-market
# Provider configuration belongs only to a distinct compute UID, not supervisor.
# External provider traffic requires an explicitly reviewed local egress proxy.
TasksMax=32
MemoryMax=1G
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
LogNamespace=member-dashboard
[Install]
WantedBy=multi-user.target
