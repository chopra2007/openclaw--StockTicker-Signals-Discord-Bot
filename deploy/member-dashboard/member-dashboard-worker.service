# REVIEW TEMPLATE. Dedicated compute UID/cgroup/PID namespace launcher is required.
[Unit]
Description=Member dashboard supervisor (unconfigured)
[Service]
Type=simple
ExecCondition=/usr/bin/false
User=UNCONFIGURED_SUPERVISOR_USER
Group=UNCONFIGURED_SUPERVISOR_GROUP
WorkingDirectory=/opt/member-dashboard/current
ExecStart=/opt/member-dashboard/venv/bin/python -m member_dashboard.operations supervisor --config /etc/member-dashboard/worker.json
Slice=member-dashboard.slice
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID
Delegate=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/member-dashboard/web /run/member-dashboard-worker
ReadOnlyPaths=/etc/member-dashboard/worker.json /etc/member-dashboard/compute.json
# Reviewed delegated subtree only; parent/other cgroups remain read-only.
ReadWritePaths=UNCONFIGURED_DELEGATED_COMPUTE_SUBTREE
InaccessiblePaths=/root /home/openclaw /var/lib/member-dashboard/quota
# Bind ONLY reviewed market DB/WAL/SHM files into /run/member-dashboard-market.
# Never bind the bot directory or grant its general group to the web user.
# BindReadOnlyPaths=UNCONFIGURED_SOURCE_DB:/run/member-dashboard-market/source.sqlite3
# BindReadOnlyPaths=UNCONFIGURED_SOURCE_WAL:/run/member-dashboard-market/source.sqlite3-wal
# BindReadOnlyPaths=UNCONFIGURED_SOURCE_SHM:/run/member-dashboard-market/source.sqlite3-shm
# Provider configuration belongs only to a distinct compute UID, not supervisor.
# External provider traffic requires an explicitly reviewed local egress proxy.
TasksMax=32
MemoryMax=1G
KillMode=control-group
TimeoutStopSec=10
Restart=no
StandardOutput=journal
StandardError=journal
LogNamespace=member-dashboard
