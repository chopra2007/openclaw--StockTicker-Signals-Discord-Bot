# No PartOf/BindsTo web units: retain this broker while bot clients depend on it.
[Unit]
Description=Independent member dashboard quota admission
[Service]
Type=simple
User=md-quota
Group=md-quota
WorkingDirectory=/opt/member-dashboard/current
# A killed server leaves its socket file behind; binding again would fail.
ExecStartPre=/bin/rm -f /run/member-dashboard-quota/budget.sock /run/member-dashboard-quota/control.sock
ExecStart=/opt/member-dashboard/venv/bin/python -m member_dashboard.operations quota --config /etc/member-dashboard/quota.json
Slice=member-dashboard.slice
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/member-dashboard/quota /run/member-dashboard-quota
ReadOnlyPaths=/etc/member-dashboard/quota.json
InaccessiblePaths=-/root -/home/openclaw -/var/lib/member-dashboard/web -/etc/member-dashboard/providers
TasksMax=8
MemoryMax=256M
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
LogNamespace=member-dashboard
[Install]
WantedBy=multi-user.target
