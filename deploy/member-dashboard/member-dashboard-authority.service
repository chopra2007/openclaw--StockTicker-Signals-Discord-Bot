# REVIEW TEMPLATE. Independent denial continuity only; no positive rights grants.
[Unit]
Description=Member dashboard denial authority
[Service]
Type=simple
ExecCondition=/usr/bin/false
User=UNCONFIGURED_ROLE_USER
Group=UNCONFIGURED_ROLE_GROUP
WorkingDirectory=/opt/member-dashboard/current
Slice=member-dashboard.slice
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
TasksMax=8
MemoryMax=256M
KillMode=control-group
TimeoutStopSec=10
Restart=no
StandardOutput=journal
StandardError=journal
LogNamespace=member-dashboard
ExecStart=/opt/member-dashboard/venv/bin/python -m member_dashboard.operations authority --config /etc/member-dashboard/authority.json
ReadWritePaths=/var/lib/member-dashboard/denials /var/lib/member-dashboard-high-water /run/member-dashboard-authority
ReadOnlyPaths=/etc/member-dashboard/authority.json
InaccessiblePaths=/root /home/openclaw /var/lib/member-dashboard/web /var/lib/member-dashboard/quota /etc/member-dashboard/providers
