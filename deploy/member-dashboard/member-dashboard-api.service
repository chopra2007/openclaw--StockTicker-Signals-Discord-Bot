# Installed by provision.sh. Loopback only (127.0.0.1:3445); no public address until go-live.
[Unit]
Description=Member dashboard API
[Service]
Type=simple
User=md-api
Group=md-api
WorkingDirectory=/opt/member-dashboard/current
ExecStart=/opt/member-dashboard/venv/bin/python -m member_dashboard.operations api --config /etc/member-dashboard/api.json
Slice=member-dashboard.slice
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/member-dashboard/web
ReadOnlyPaths=/etc/member-dashboard/api.json /etc/member-dashboard/api-signing-key
InaccessiblePaths=-/root -/home/openclaw -/var/lib/member-dashboard/quota -/var/lib/member-dashboard/denials -/var/lib/member-dashboard-high-water -/run/member-dashboard-market -/etc/member-dashboard/providers
TasksMax=24
MemoryMax=512M
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
LogNamespace=member-dashboard
[Install]
WantedBy=multi-user.target
