[Unit]
Description=Member dashboard frontend (unconfigured)
[Service]
Type=simple
ExecCondition=/usr/bin/false
User=UNCONFIGURED_FRONTEND_USER
Group=UNCONFIGURED_FRONTEND_GROUP
WorkingDirectory=/opt/member-dashboard/current/web/member-dashboard
ExecStart=/opt/member-dashboard/node/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3444
Slice=member-dashboard.slice
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=/root /home/openclaw /var/lib/member-dashboard /etc/member-dashboard /run/member-dashboard-quota /run/member-dashboard-market
TasksMax=24
MemoryMax=512M
KillMode=control-group
TimeoutStopSec=10
Restart=no
StandardOutput=journal
StandardError=journal
LogNamespace=member-dashboard
