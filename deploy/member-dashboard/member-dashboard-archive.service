# REVIEW TEMPLATE. Logical authenticated expiry removal; no media-erasure claim.
[Unit]
Description=Member dashboard archive retention
[Service]
Type=oneshot
ExecCondition=/usr/bin/false
User=md-archive
Group=md-archive
WorkingDirectory=/opt/member-dashboard/current
Slice=member-dashboard.slice
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
TasksMax=8
MemoryMax=256M
KillMode=control-group
TimeoutStopSec=10
Restart=no
StandardOutput=journal
StandardError=journal
LogNamespace=member-dashboard
ExecStart=/opt/member-dashboard/venv/bin/python -m member_dashboard.operations archive --config /etc/member-dashboard/archive.json
RuntimeMaxSec=45
ReadWritePaths=/var/lib/member-dashboard/archives
ReadOnlyPaths=/etc/member-dashboard/archive.json /etc/member-dashboard/archive-key
InaccessiblePaths=-/root -/home/openclaw -/var/lib/member-dashboard/web -/var/lib/member-dashboard/quota -/var/lib/member-dashboard/denials -/var/lib/member-dashboard-high-water -/etc/member-dashboard/providers
